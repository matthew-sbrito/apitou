# Supabase dashboard → Settings → API Keys (some projects still show the
# older "API" tab instead of "API Keys" — same values, different label).
#
# NEXT_PUBLIC_SUPABASE_URL   -> "Project URL" (Settings → General/Data API)
# NEXT_PUBLIC_SUPABASE_ANON_KEY -> the low-privilege public key. Newer
#   Supabase projects renamed this from "anon key" to "Publishable key"
#   (starts with sb_publishable_...) — if you don't see "anon key" on the
#   API Keys page, that's the one to use instead. Either works here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used to build the OAuth redirect (http://localhost:3000 in dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed for the Supabase keep-alive cron endpoint (see docs/mvp/PLAN.md
# §2 "Cuidados com o free tier" — the free tier pauses after 7 days idle).
# Settings → API Keys → the high-privilege key, labeled "service_role" on
# older projects or "Secret key" (sb_secret_...) on newer ones. Never expose
# this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for run migrations
SUPABASE_DATABASE_URL=
